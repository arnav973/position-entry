{
  "id": "com.example.dynamicpositionmanage",
  "version": "11.0.0",
  "name": "Dynamic Position Manage Widget",
  "description": "Production-ready dynamic SAC custom widget with configurable columns, buttons, model binding and editable table UI.",
  "newInstancePrefix": "DynamicPositionManage",
  "vendor": "Arnav",
  "icon": "sap-icon://table-view",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-example-dynamic-position-manage",
      "url": "https://arnav973.github.io/position-entry/webcomponent.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-example-dynamic-position-manage-builder",
      "url": "https://arnav973.github.io/position-entry/builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "managedata": {
      "type": "string",
      "default": "[]"
    },
    "lastevent": {
      "type": "string",
      "default": ""
    },
    "validationresult": {
      "type": "string",
      "default": "true"
    },
    "validationerrors": {
      "type": "string",
      "default": "[]"
    },
    "title": {
      "type": "string",
      "default": "Dynamic Position Manager"
    },
    "searchplaceholder": {
      "type": "string",
      "default": "Search..."
    },
    "pagesize": {
      "type": "integer",
      "default": 50
    },
    "datamode": {
      "type": "string",
      "default": "manual"
    },
    "schema": {
      "type": "string",
      "default": "[]"
    },
    "buttons": {
      "type": "string",
      "default": "[]"
    },
    "modelbinding": {
      "type": "string",
      "default": "{}"
    }
  },
  "methods": {
    "getManageData": {
      "description": "Get current table data",
      "returnType": "string"
    },
    "setManageData": {
      "description": "Set current table data",
      "parameters": [
        {
          "name": "dataStr",
          "type": "string"
        }
      ]
    },
    "getModifiedRows": {
      "description": "Get modified rows only",
      "returnType": "string"
    },
    "getSelectedRows": {
      "description": "Get selected rows only",
      "returnType": "string"
    },
    "clear": {
      "description": "Clear all rows"
    },
    "validate": {
      "description": "Validate selected rows",
      "returnType": "string"
    },
    "setOptions": {
      "description": "Set dropdown options for a field",
      "parameters": [
        {
          "name": "fieldName",
          "type": "string"
        },
        {
          "name": "optionsStr",
          "type": "string"
        }
      ]
    },
    "setRowOptions": {
      "description": "Set row level dropdown options",
      "parameters": [
        {
          "name": "rowIndex",
          "type": "integer"
        },
        {
          "name": "fieldName",
          "type": "string"
        },
        {
          "name": "optionsStr",
          "type": "string"
        }
      ]
    },
    "commitRowOptions": {
      "description": "Re-render after bulk row option changes"
    },
    "setCellValue": {
      "description": "Set a single cell value",
      "parameters": [
        {
          "name": "rowIndex",
          "type": "integer"
        },
        {
          "name": "fieldName",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string"
        }
      ]
    },
    "getVisibleIndexForRow": {
      "description": "Convert actual row index to visible row index",
      "parameters": [
        {
          "name": "actualRowIndex",
          "type": "integer"
        }
      ],
      "returnType": "integer"
    },
    "setSchema": {
      "description": "Set dynamic schema",
      "parameters": [
        {
          "name": "schemaStr",
          "type": "string"
        }
      ]
    },
    "setButtons": {
      "description": "Set dynamic buttons",
      "parameters": [
        {
          "name": "buttonsStr",
          "type": "string"
        }
      ]
    },
    "applyResultSet": {
      "description": "Apply result set using model binding",
      "parameters": [
        {
          "name": "resultSetStr",
          "type": "string"
        }
      ]
    },
    "triggerButtonAction": {
      "description": "Trigger custom dynamic action",
      "parameters": [
        {
          "name": "actionName",
          "type": "string"
        }
      ]
    },
    "getLastEvent": {
      "description": "Get last event",
      "returnType": "string"
    },
    "getValidationErrors": {
      "description": "Get validation errors",
      "returnType": "string"
    },
    "getValidationResult": {
      "description": "Get validation result",
      "returnType": "string"
    },
    "loadData": {
      "description": "Trigger load data event"
    },
    "saveData": {
      "description": "Trigger save data event"
    },
    "deleteSelected": {
      "description": "Trigger delete selected event"
    }
  },
  "events": {
    "onDataChange": {
      "description": "Triggered on any row data change"
    },
    "onValidate": {
      "description": "Triggered after validate"
    },
    "onReady": {
      "description": "Triggered when widget is ready"
    },
    "onCustomButton": {
      "description": "Triggered when custom dynamic button clicked"
    }
  }
}
