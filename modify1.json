{
  "id": "com.example.dynamicmodelwidget",
  "version": "1.0.13",
  "name": "Dynamic Model Table Widget",
  "description": "Custom widget with native model/dimension/measure selection in Builder Panel, dynamic buttons, and editable table.",
  "newInstancePrefix": "DynamicModelWidget",
  "vendor": "Arnav",
  "icon": "sap-icon://table-view",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-example-dynamic-model-widget",
      "url": "https://arnav973.github.io/position-entry/webcomponent.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-example-dynamic-model-widget-styling",
      "url": "https://arnav973.github.io/position-entry/styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "myDataBinding": {
      "type": "dataBinding"
    },
    "title": {
      "type": "string",
      "default": "Dynamic Model Table"
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Search..."
    },
    "pageSize": {
      "type": "integer",
      "default": 50
    },
    "allowEditMeasures": {
      "type": "boolean",
      "default": true
    },
    "button1Text": { "type": "string", "default": "Load Data" },
    "button1Action": { "type": "string", "default": "loadData" },
    "button1Style": { "type": "string", "default": "default" },

    "button2Text": { "type": "string", "default": "Validate" },
    "button2Action": { "type": "string", "default": "validate" },
    "button2Style": { "type": "string", "default": "default" },

    "button3Text": { "type": "string", "default": "Save Changes" },
    "button3Action": { "type": "string", "default": "saveData" },
    "button3Style": { "type": "string", "default": "primary" },

    "button4Text": { "type": "string", "default": "Delete Selected" },
    "button4Action": { "type": "string", "default": "deleteSelected" },
    "button4Style": { "type": "string", "default": "danger" },

    "button5Text": { "type": "string", "default": "" },
    "button5Action": { "type": "string", "default": "" },
    "button5Style": { "type": "string", "default": "default" },

    "button6Text": { "type": "string", "default": "" },
    "button6Action": { "type": "string", "default": "" },
    "button6Style": { "type": "string", "default": "default" },

    "managedata": {
      "type": "string",
      "default": "[]"
    },
    "lastevent": {
      "type": "string",
      "default": ""
    },
    "validationresult": {
      "type": "string",
      "default": "true"
    },
    "validationerrors": {
      "type": "string",
      "default": "[]"
    }
  },
  "methods": {
    "getManageData": { "description": "Get current table data as JSON", "returnType": "string" },
    "setManageData": {
      "description": "Override table data manually",
      "parameters": [{ "name": "dataStr", "type": "string" }]
    },
    "getModifiedRows": { "description": "Get modified rows", "returnType": "string" },
    "getSelectedRows": { "description": "Get selected rows", "returnType": "string" },
    "clear": { "description": "Clear all rows" },
    "validate": { "description": "Validate selected rows", "returnType": "string" },
    "getLastEvent": { "description": "Get last event", "returnType": "string" },
    "getValidationErrors": { "description": "Get validation errors", "returnType": "string" },
    "getValidationResult": { "description": "Get validation result", "returnType": "string" },
    "loadData": { "description": "Trigger load event" },
    "saveData": { "description": "Trigger save event" },
    "deleteSelected": { "description": "Delete selected rows locally" },
    "triggerButtonAction": {
      "description": "Trigger a custom button action",
      "parameters": [{ "name": "actionName", "type": "string" }]
    }
  },
  "events": {
    "onDataChange": { "description": "Triggered when data changes" },
    "onValidate": { "description": "Triggered after validate" },
    "onReady": { "description": "Triggered when widget is ready" },
    "onCustomButton": { "description": "Triggered when a custom button is clicked" }
  }
}
