{
  "id": "com.example.dynamicmodelwidget",
  "version": "2.0.13",
  "name": "Dynamic Model Table Widget",
  "description": "Custom widget with native model/dimension/measure selection and dynamic buttons configurable from the Styling Panel.",
  "newInstancePrefix": "DynamicModelWidget",
  "vendor": "Arnav",
  "icon": "https://arnav973.github.io/position-entry/icon.png",
  "eula": "",
  "license": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-example-dynamic-model-widget",
      "url": "https://arnav973.github.io/position-entry/webcomponent.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-example-dynamic-model-widget-styling",
      "url": "https://arnav973.github.io/position-entry/styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Widget title shown at the top",
      "default": "Dynamic Model Table"
    },
    "searchPlaceholder": {
      "type": "string",
      "description": "Placeholder text for the search box",
      "default": "Search..."
    },
    "pageSize": {
      "type": "integer",
      "description": "Number of rows per page",
      "default": 50
    },
    "allowEditMeasures": {
      "type": "boolean",
      "description": "Whether measure cells are editable",
      "default": true
    },
    "buttonsConfig": {
      "type": "string",
      "description": "JSON array of button definitions created from the Styling Panel",
      "default": "[]"
    },
    "managedata": {
      "type": "string",
      "description": "Current table data as JSON",
      "default": "[]"
    },
    "lastevent": {
      "type": "string",
      "description": "Last internal event fired",
      "default": ""
    },
    "validationresult": {
      "type": "string",
      "description": "Result of last validation",
      "default": "true"
    },
    "validationerrors": {
      "type": "string",
      "description": "Validation errors as JSON",
      "default": "[]"
    }
  },
  "methods": {
    "getManageData": {
      "description": "Get current table data as JSON string"
    },
    "setManageData": {
      "description": "Override table data manually",
      "parameters": [
        { "name": "dataStr", "type": "string", "description": "JSON array string" }
      ]
    },
    "getModifiedRows": {
      "description": "Get modified rows as JSON string"
    },
    "getSelectedRows": {
      "description": "Get selected rows as JSON string"
    },
    "clear": {
      "description": "Clear all rows"
    },
    "validate": {
      "description": "Validate selected rows",
      "returnType": "string"
    },
    "getLastEvent": {
      "description": "Get last internal event",
      "returnType": "string"
    },
    "getValidationErrors": {
      "description": "Get validation errors as JSON string",
      "returnType": "string"
    },
    "getValidationResult": {
      "description": "Get validation result",
      "returnType": "string"
    },
    "loadData": {
      "description": "Reload data from the current data binding"
    },
    "saveData": {
      "description": "Trigger save event"
    },
    "deleteSelected": {
      "description": "Delete selected rows locally"
    },
    "triggerButtonAction": {
      "description": "Trigger a dynamic button action by name",
      "parameters": [
        { "name": "actionName", "type": "string", "description": "The action identifier" }
      ]
    }
  },
  "events": {
    "onDataChange": {
      "description": "Fired when data changes"
    },
    "onValidate": {
      "description": "Fired after validate() is called"
    },
    "onReady": {
      "description": "Fired when the widget is initialized"
    },
    "onCustomButton": {
      "description": "Fired when a dynamic button is clicked"
    }
  },
  "dataBindings": {
    "myDataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures",
          "type": "mainStructureMember"
        }
      ]
    }
  }
}
